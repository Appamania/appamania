rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function capped(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= max;
    }

    match /notes/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'link', 'offer', 'received'])
        && request.resource.data.offer is string
        && request.resource.data.offer.size() <= 20
        && capped('name', 200)
        && capped('email', 200)
        && capped('message', 4000)
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 500
        && request.resource.data.link.matches('(?i)(https?://.*)?')
        && request.resource.data.received is string
        && request.resource.data.received.size() <= 40;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
