rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read. Uploads go through the Firebase console, which bypasses rules.
    match /media/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
