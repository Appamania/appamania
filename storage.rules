rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sumit@appamania.in'
        && request.auth.token.email_verified == true;
    }
    // Site media: public read, admin write. Images under 5 MB, mp4 under 50 MB.
    match /media/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType == 'video/mp4' && request.resource.size < 50 * 1024 * 1024));
      allow delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
